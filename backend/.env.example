# ===== 应用 =====
APP_NAME=web-sales
API_PREFIX=/api
LOG_LEVEL=INFO
LOG_DIR=logs

# ===== 数据库 =====
# 生产（MySQL 8 / utf8mb4）：
DATABASE_URL=mysql+pymysql://websales:CHANGE_ME@127.0.0.1:3306/web_sales?charset=utf8mb4
# 本地开发可直接用 SQLite：
# DATABASE_URL=sqlite:///./web_sales.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# ===== 鉴权 =====
# 生产必须替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ===== 临时链接 =====
# 子系统 H5 对外访问地址，用于拼接完整临时链接（末尾不要带 /）。
# 路径前缀方案（Nginx 同域名 + /portal/）需写成 https://your-domain.com/portal
# 独立域名方案则写 https://portal.your-domain.com
# 最终链接形如 {PUBLIC_BASE_URL}/#/order?t=<token>
PUBLIC_BASE_URL=https://your-domain.com/portal
# 同一 token 每分钟最多提交订单数（内存节流，防刷单）
PORTAL_RATE_LIMIT_PER_MINUTE=10

# ===== 跨域 =====
# 主系统后台与子系统 H5 的站点地址，逗号分隔
CORS_ORIGINS=https://admin.example.com,https://portal.example.com
